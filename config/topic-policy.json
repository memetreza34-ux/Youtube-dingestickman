{
  "topicPolicyVersion": 3,
  "status": "READY",
  "director": "topic-director-v2",
  "purpose": "Generate broadly, score rigorously, reject weak anecdote-only ideas, and preserve channel diversity.",
  "scorecard": {
    "schemaVersion": 1,
    "file": "99-technik/TOPIC_SCORECARD.json",
    "requiredForNewProjects": true,
    "statusRequired": "APPROVED",
    "approvedByTopicDirectorRequired": true
  },
  "discovery": {
    "minimumRawCandidates": 30,
    "shortlistSize": 12,
    "productionThreshold": 7.6,
    "priorityThreshold": 8.3,
    "preferPriorityOrStrongOnly": true
  },
  "scoreDimensions": {
    "curiosityGap": 1.3,
    "stakes": 1.2,
    "storyEngine": 1.5,
    "visualPotential": 1.3,
    "historicalSignificance": 1.0,
    "freshnessDistinctiveness": 1.0,
    "titlePotential": 1.0,
    "sourceability": 1.0
  },
  "requiredBeforeProduction": {
    "duplicateCheckPassed": true,
    "storyEnginePresent": true,
    "minimumDifferentVisualForms": 5,
    "minimumTitleDirections": 3,
    "sourceabilityRequired": true,
    "diversityGateRequired": true,
    "isolatedAnecdoteAloneInsufficient": true,
    "largerHistoricalPointRequired": true
  },
  "topicFamilies": [
    "rise_power_collapse",
    "disaster_survival",
    "decisions_with_massive_consequences",
    "betrayal_intrigue_crime_power",
    "daily_life_with_real_question",
    "technology_infrastructure_systems",
    "borders_maps_lost_worlds",
    "historical_mysteries_reconstruction",
    "war_beyond_battles",
    "strange_history_with_larger_point"
  ],
  "diversity": {
    "avoidThreeSameEraInRow": true,
    "avoidRepeatedPersonAnecdoteDefault": true,
    "afterTwoPersonAnecdotesPreferDifferentFamily": true,
    "preferAtLeastTwoChangesFromRecentVideos": [
      "era",
      "region_or_culture",
      "topic_family",
      "story_form",
      "visual_world",
      "scale"
    ]
  },
  "duplicateStatusPolicy": {
    "softStatusPatterns": ["test", "paused", "rejected", "archived", "cancelled", "legacy"],
    "softMatchesNeverHardBlock": true,
    "activeOrReservedMatchesMayBlock": true,
    "currentProjectMustBeExcludedFromSelfCheck": true
  },
  "forbiddenDefaults": [
    "famous person plus weird anecdote plus trick as automatic choice",
    "only rulers and generals",
    "only warfare",
    "three Rome or Antiquity topics in direct succession",
    "topic is interesting only because of exaggerated clickbait",
    "visually monotonous topic with no compensating story strength",
    "weak source base for the central claim"
  ],
  "qualityBands": {
    "PRIORITY": [8.3, 10.0],
    "STRONG": [7.6, 8.29],
    "MAYBE": [7.0, 7.59],
    "REJECT": [0.0, 6.99]
  },
  "qualityAuthority": "channel/02-TOPIC-SYSTEM.md",
  "duplicateChecker": "src/cli/check-youtube-topic.js",
  "technicalValidator": "src/cli/validate-youtube-preproduction.js"
}
